# Copy this file to .env.local for running on your computer,
# and add the same values in Vercel → Project → Settings → Environment Variables.

# Neon: Dashboard → your project → Connect → copy the connection string
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Any long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Anthropic: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Stripe: dashboard.stripe.com → Developers → API keys (use sk_test_ first, sk_live_ for the real $1 charge)
STRIPE_SECRET_KEY=sk_test_...
# Stripe: Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Your live site address (no trailing slash). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional settings
# PRO_PRICE_CENTS=100      # Pro price per month in cents (100 = $1)
# FREE_WEEKLY_LIMIT=3      # free recipe searches per 7 days
